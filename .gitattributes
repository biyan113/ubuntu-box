* text=auto

# Shell scripts and guest-side files must keep LF when checked out on Windows.
*.sh text eol=lf
gradlew text eol=lf
app/src/main/assets/guest/* text eol=lf

# Source files
*.java text eol=lf
*.xml text eol=lf
*.md text eol=lf

# Binary assets
*.bin binary
*.so binary
*.png binary
*.jar binary
